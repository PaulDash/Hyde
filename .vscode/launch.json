{
    "inputs": [
        {
            "id": "hydeArgs",
            "type": "promptString",
            "description": "Arguments to pass to Hyde.ps1",
            "default": "Build -Verbose"
        }
    ],
    "configurations": [
        {
            "name": "Debug Hyde Build",
            "type": "PowerShell",
            "request": "launch",
            "script": "${workspaceFolder}\\src\\hyde.ps1",
            "cwd": "${workspaceFolder}",
            "args": ["${input:hydeArgs}"]
        }
    ]
}
